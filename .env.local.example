# Copy this file to `.env.local` and fill in your Firebase project values.
# Firebase Console -> Project settings -> General -> Your apps -> Web app.
#
# NOTE: these values are safe to expose in the browser (they are not secrets),
# but keeping them in env vars lets you point at different Firebase projects
# for dev/prod without editing code.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Only used by the legacy vanilla site (home.js). The Next.js app now uploads
# to Cloudinary instead, so this can be omitted for v2-only deployments.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# File uploads (Cloudinary). Both values are public client-side identifiers —
# never put your API key or API secret in NEXT_PUBLIC_* variables.
#
# Cloud name: Cloudinary Console -> Dashboard -> "Cloud name".
# Upload preset: Cloudinary Console -> Settings -> Upload -> Upload presets ->
#   create one with Signing Mode = "Unsigned" and note its name.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
